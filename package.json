{
  "name": "office-office",
  "version": "2.0.0",
  "description": "Office Office — a local-first multi-agent coding orchestrator for real developer workflows.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "office": "./bin/office.js"
  },
  "files": [
    "bin",
    "dist",
    "web",
    "agents",
    "skills",
    "templates",
    "docs",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "fastify": "^5.6.1",
    "@fastify/static": "^8.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
